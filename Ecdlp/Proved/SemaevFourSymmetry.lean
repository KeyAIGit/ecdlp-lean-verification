import Mathlib
import Ecdlp.Proved.SemaevFour

/-!
# Semaev's `S₄`: full `Sym(4)` symmetry and degree exactly 4 in each variable

Completes two gaps left by `Ecdlp/Proved/SemaevFour.lean`, where
`S₄ = (S₃poly a b x₁ x₂).resultant (S₃poly a b x₃ x₄) 2 2`.

**Symmetry.** `S₄_symm₁₂`, `S₄_symm₃₄` and `S₄_block_swap` generate only an order-8 subgroup
of the 24 permutations of `(x₁,x₂,x₃,x₄)` (a group-theoretic remark, not kernel-checked). The
missing transposition `x₂ ↔ x₃` (`S₄_symm₂₃`) is proved from a closed form of the fixed-size
`(2,2)` resultant (`resultant_quadratic_two_two`, `S₄_closed`). With it, `S₄_perm` gives
invariance under every `σ : Equiv.Perm (Fin 4)`, by induction over the adjacent transpositions
(`Equiv.Perm.mclosure_swap_castSucc_succ`). All of this holds over any commutative ring, so
it also applies to `S₄` evaluated at polynomials (e.g. over `K[X]`, used below).

**Degree.** `S₄slice a b x₁ x₂ x₃` is `S₄` as a polynomial in its last argument. It has
degree at most `4` over any commutative ring, and its coefficient of `X⁴` is
`S₃(x₁,x₂,x₃)²` (`S₄slice_coeff_four`). Over a field it therefore has degree exactly
`4 = 2^(4−2)` whenever `S₃(x₁,x₂,x₃) ≠ 0` (`S₄slice_natDegree`), the same holds with the
variable in any argument slot (`S₄_natDegree_eq_four_of_perm`, via `S₄_perm` over `K[X]`),
and at most four `x₄` complete such a triple to a zero of `S₄` (`S₄_completions_le_four`).
When `S₃(x₁,x₂,x₃) = 0` the degree in `x₄` drops; that case is not covered here.

These are algebraic facts about the polynomial `S₄`; nothing here concerns a specific curve or
a specific discrete logarithm.
-/

namespace Ecdlp.Semaev

open Polynomial

variable {F : Type*} [CommRing F]

/-- The fixed-size `(2,2)` resultant of two quadratic coefficient triples, in closed form
(valid even when a leading coefficient vanishes). -/
theorem resultant_quadratic_two_two (a₁ b₁ c₁ a₂ b₂ c₂ : F) :
    (C a₁ * X ^ 2 + C b₁ * X + C c₁).resultant (C a₂ * X ^ 2 + C b₂ * X + C c₂) 2 2
      = (a₁ * c₂ - a₂ * c₁) ^ 2 - (a₁ * b₂ - a₂ * b₁) * (b₁ * c₂ - b₂ * c₁) := by
  set f : F[X] := C a₁ * X ^ 2 + C b₁ * X + C c₁
  set g : F[X] := C a₂ * X ^ 2 + C b₂ * X + C c₂
  have hf0 : f.coeff 0 = c₁ := by simp [f]
  have hf1 : f.coeff 1 = b₁ := by simp [f]
  have hf2 : f.coeff 2 = a₁ := by simp [f]
  have hg0 : g.coeff 0 = c₂ := by simp [g]
  have hg1 : g.coeff 1 = b₂ := by simp [g]
  have hg2 : g.coeff 2 = a₂ := by simp [g]
  have hM : sylvester f g 2 2 =
      !![c₂, 0, c₁, 0; b₂, c₂, b₁, c₁; a₂, b₂, a₁, b₁; 0, a₂, 0, a₁] := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [sylvester, Fin.addCases, hf0, hf1, hf2, hg0, hg1, hg2]
  rw [resultant, hM, Matrix.det_succ_row_zero]
  simp [Fin.sum_univ_succ, Matrix.det_fin_three, Fin.succAbove, Matrix.submatrix]
  ring

/-- `S₄` in closed form, from `resultant_quadratic_two_two`. -/
theorem S₄_closed (a b x₁ x₂ x₃ x₄ : F) :
    S₄ a b x₁ x₂ x₃ x₄ =
      let A₁ := (x₁ - x₂) ^ 2
      let B₁ := -(2 * ((x₁ + x₂) * (x₁ * x₂ + a) + 2 * b))
      let C₁ := (x₁ * x₂ - a) ^ 2 - 4 * b * (x₁ + x₂)
      let A₂ := (x₃ - x₄) ^ 2
      let B₂ := -(2 * ((x₃ + x₄) * (x₃ * x₄ + a) + 2 * b))
      let C₂ := (x₃ * x₄ - a) ^ 2 - 4 * b * (x₃ + x₄)
      (A₁ * C₂ - A₂ * C₁) ^ 2 - (A₁ * B₂ - A₂ * B₁) * (B₁ * C₂ - B₂ * C₁) := by
  rw [S₄, S₃poly, S₃poly, resultant_quadratic_two_two]

/-- The transposition `x₂ ↔ x₃`, which is not in the subgroup generated by `S₄_symm₁₂`,
`S₄_symm₃₄` and `S₄_block_swap` (not kernel-checked). Proved by `ring` on the closed form. -/
theorem S₄_symm₂₃ (a b x₁ x₂ x₃ x₄ : F) :
    S₄ a b x₁ x₂ x₃ x₄ = S₄ a b x₁ x₃ x₂ x₄ := by
  rw [S₄_closed, S₄_closed]
  ring

/-- **Full `Sym(4)` invariance of `S₄`:** permuting the four `x`-arguments by any
`σ : Equiv.Perm (Fin 4)` leaves `S₄` unchanged. The permutations with this property form a
submonoid containing the adjacent transpositions (`S₄_symm₁₂`, `S₄_symm₂₃`, `S₄_symm₃₄`),
which generate `Equiv.Perm (Fin 4)` (`Equiv.Perm.mclosure_swap_castSucc_succ`). -/
theorem S₄_perm (a b : F) (σ : Equiv.Perm (Fin 4)) (x : Fin 4 → F) :
    S₄ a b (x (σ 0)) (x (σ 1)) (x (σ 2)) (x (σ 3)) = S₄ a b (x 0) (x 1) (x 2) (x 3) := by
  let M : Submonoid (Equiv.Perm (Fin 4)) :=
    { carrier := {τ | ∀ y : Fin 4 → F,
        S₄ a b (y (τ 0)) (y (τ 1)) (y (τ 2)) (y (τ 3)) = S₄ a b (y 0) (y 1) (y 2) (y 3)}
      one_mem' := fun _ => rfl
      mul_mem' := fun {τ ρ} hτ hρ y => by
        simp only [Set.mem_setOf_eq, Equiv.Perm.mul_apply] at hτ hρ ⊢
        exact (hρ fun k => y (τ k)).trans (hτ y) }
  have hgen : Submonoid.closure
      (Set.range fun i : Fin 3 => Equiv.swap i.castSucc i.succ) ≤ M := by
    rw [Submonoid.closure_le]
    rintro _ ⟨i, rfl⟩ y
    fin_cases i
    · exact (S₄_symm₁₂ a b (y 0) (y 1) (y 2) (y 3)).symm
    · exact (S₄_symm₂₃ a b (y 0) (y 1) (y 2) (y 3)).symm
    · exact (S₄_symm₃₄ a b (y 0) (y 1) (y 2) (y 3)).symm
  have hσ : σ ∈ M := hgen (by rw [Equiv.Perm.mclosure_swap_castSucc_succ]; trivial)
  exact hσ x

/-- `S₄` as a univariate polynomial in its fourth argument, the other arguments being
constants. -/
noncomputable def S₄slice (a b x₁ x₂ x₃ : F) : F[X] :=
  S₄ (C a) (C b) (C x₁) (C x₂) (C x₃) X

theorem S₄slice_eval (a b x₁ x₂ x₃ x₄ : F) :
    (S₄slice a b x₁ x₂ x₃).eval x₄ = S₄ a b x₁ x₂ x₃ x₄ := by
  rw [S₄slice, S₄_closed, S₄_closed]
  simp only [eval_add, eval_sub, eval_mul, eval_pow, eval_neg, eval_C, eval_X, eval_ofNat]

/-- Degree at most `4` in the last variable, over any commutative ring. -/
theorem S₄slice_natDegree_le (a b x₁ x₂ x₃ : F) :
    (S₄slice a b x₁ x₂ x₃).natDegree ≤ 4 := by
  rw [S₄slice, S₄_closed]
  simp only
  generalize hA : (C x₁ - C x₂ : F[X]) ^ 2 = A
  generalize hB : -(2 * ((C x₁ + C x₂) * (C x₁ * C x₂ + C a) + 2 * C b) : F[X]) = B
  generalize hC : ((C x₁ * C x₂ - C a) ^ 2 - 4 * C b * (C x₁ + C x₂) : F[X]) = Cc
  have hA0 : A.natDegree = 0 := by rw [← hA]; simp only [← C_sub, ← C_pow]; exact natDegree_C _
  have hB0 : B.natDegree = 0 := by
    rw [← hB]; simp only [← C_ofNat, ← C_mul, ← C_add, ← C_neg]; exact natDegree_C _
  have hC0 : Cc.natDegree = 0 := by
    rw [← hC]; simp only [← C_ofNat, ← C_mul, ← C_add, ← C_sub, ← C_pow]; exact natDegree_C _
  have h2 : ((C x₃ - X : F[X]) ^ 2).natDegree ≤ 2 := by compute_degree
  have h2' : (-(2 * ((C x₃ + X) * (C x₃ * X + C a) + 2 * C b)) : F[X]).natDegree ≤ 2 := by
    compute_degree
  have h2'' : (((C x₃ * X - C a) ^ 2 - 4 * C b * (C x₃ + X)) : F[X]).natDegree ≤ 2 := by
    compute_degree
  generalize (C x₃ - X : F[X]) ^ 2 = A' at h2 ⊢
  generalize (-(2 * ((C x₃ + X) * (C x₃ * X + C a) + 2 * C b)) : F[X]) = B' at h2' ⊢
  generalize (((C x₃ * X - C a) ^ 2 - 4 * C b * (C x₃ + X)) : F[X]) = C' at h2'' ⊢
  have m : ∀ p q : F[X], p.natDegree = 0 → q.natDegree ≤ 2 → (p * q).natDegree ≤ 2 :=
    fun p q hp hq => (natDegree_mul_le).trans (by omega)
  have m' : ∀ p q : F[X], q.natDegree = 0 → p.natDegree ≤ 2 → (p * q).natDegree ≤ 2 :=
    fun p q hq hp => (natDegree_mul_le).trans (by omega)
  refine (natDegree_sub_le _ _).trans (max_le ?_ ?_)
  · refine natDegree_pow_le.trans ?_
    have := (natDegree_sub_le (A * C') (A' * Cc)).trans
      (max_le (m _ _ hA0 h2'') (m' _ _ hC0 h2))
    nlinarith
  · refine natDegree_mul_le.trans ?_
    have h1 := (natDegree_sub_le (A * B') (A' * B)).trans
      (max_le (m _ _ hA0 h2') (m' _ _ hB0 h2))
    have h3 := (natDegree_sub_le (B * C') (B' * Cc)).trans
      (max_le (m _ _ hB0 h2'') (m' _ _ hC0 h2'))
    omega

/-- The coefficient of `x₄⁴` in `S₄` is `S₃(x₁,x₂,x₃)²`. Proof: split the slice as
`C(p² − q·t)·X⁴ + X²·L + M` with `natDegree L ≤ 1` and `natDegree M ≤ 2`. -/
theorem S₄slice_coeff_four (a b x₁ x₂ x₃ : F) :
    (S₄slice a b x₁ x₂ x₃).coeff 4 = S₃ a b x₁ x₂ x₃ ^ 2 := by
  -- constants of the first slice
  set α : F := (x₁ - x₂) ^ 2 with hα
  set β : F := -(2 * ((x₁ + x₂) * (x₁ * x₂ + a) + 2 * b)) with hβ
  set γ : F := (x₁ * x₂ - a) ^ 2 - 4 * b * (x₁ + x₂) with hγ
  -- lower (degree ≤ 1) parts of the second slice, as polynomials in x₄ = X
  set a₁ : F[X] := C (-2 * x₃) * X + C (x₃ ^ 2) with ha₁
  set b₁ : F[X] := C (-2 * (x₃ ^ 2 + a)) * X + C (-2 * (a * x₃ + 2 * b)) with hb₁
  set c₁ : F[X] := C (-2 * a * x₃ - 4 * b) * X + C (a ^ 2 - 4 * b * x₃) with hc₁
  set r : F[X] := C α * c₁ - C γ * a₁ with hr
  set s : F[X] := C α * b₁ - C β * a₁ with hs
  set w : F[X] := C β * c₁ - C γ * b₁ with hw
  set p : F := α * x₃ ^ 2 - γ with hp
  set q : F := α * (-2 * x₃) - β with hq
  set t : F := β * x₃ ^ 2 - γ * (-2 * x₃) with ht
  have hE : S₄slice a b x₁ x₂ x₃
      = C (p ^ 2 - q * t) * X ^ 4 + X ^ 2 * (2 * C p * r - C q * w - C t * s)
        + (r ^ 2 - s * w) := by
    rw [S₄slice, S₄_closed]
    simp only [hr, hs, hw, ha₁, hb₁, hc₁, hp, hq, ht, hα, hβ, hγ, map_add, map_sub, map_mul,
      map_pow, map_neg, map_ofNat]
    ring
  have hL : (2 * C p * r - C q * w - C t * s).natDegree ≤ 1 := by
    simp only [hr, hs, hw, ha₁, hb₁, hc₁]; compute_degree
  have hM : (r ^ 2 - s * w).natDegree ≤ 2 := by
    simp only [hr, hs, hw, ha₁, hb₁, hc₁]; compute_degree
  rw [hE, coeff_add, coeff_add, coeff_C_mul_X_pow, if_pos rfl, coeff_X_pow_mul',
    if_pos (by norm_num), coeff_eq_zero_of_natDegree_lt (by omega : _ < 4 - 2),
    coeff_eq_zero_of_natDegree_lt (by omega : _ < 4)]
  simp only [hp, hq, ht, hα, hβ, hγ, S₃]
  ring

/-- **Degree exactly `4 = 2^(4−2)` in the last variable** over a field, when
`S₃(x₁,x₂,x₃) ≠ 0`. -/
theorem S₄slice_natDegree {K : Type*} [Field K] (a b x₁ x₂ x₃ : K)
    (h : S₃ a b x₁ x₂ x₃ ≠ 0) : (S₄slice a b x₁ x₂ x₃).natDegree = 4 :=
  natDegree_eq_of_le_of_coeff_ne_zero (S₄slice_natDegree_le a b x₁ x₂ x₃)
    (by rw [S₄slice_coeff_four]; exact pow_ne_zero 2 h)

/-- **Degree exactly `4` in every variable.** Place the variable `X` and three constants
`x₁, x₂, x₃` in the four argument slots in any order (`σ` chooses the order); if
`S₃(x₁,x₂,x₃) ≠ 0`, the resulting univariate polynomial has degree exactly `4`. For example
`σ = Equiv.swap 0 3` puts `X` in the first slot. Proof: `S₄_perm` over `K[X]` reduces to
`S₄slice_natDegree`. -/
theorem S₄_natDegree_eq_four_of_perm {K : Type*} [Field K] (a b x₁ x₂ x₃ : K)
    (h : S₃ a b x₁ x₂ x₃ ≠ 0) (σ : Equiv.Perm (Fin 4)) :
    (S₄ (C a) (C b) (![C x₁, C x₂, C x₃, X] (σ 0)) (![C x₁, C x₂, C x₃, X] (σ 1))
      (![C x₁, C x₂, C x₃, X] (σ 2)) (![C x₁, C x₂, C x₃, X] (σ 3))).natDegree = 4 := by
  rw [S₄_perm (C a) (C b) σ ![C x₁, C x₂, C x₃, X]]
  exact S₄slice_natDegree a b x₁ x₂ x₃ h

/-- At most four completions: if `S₃(x₁,x₂,x₃) ≠ 0`, any finite set of `x₄` with
`S₄(x₁,x₂,x₃,x₄) = 0` has at most four elements (a nonzero polynomial of degree `4` over a
field has at most four roots). -/
theorem S₄_completions_le_four {K : Type*} [Field K] [DecidableEq K] (a b x₁ x₂ x₃ : K)
    (h : S₃ a b x₁ x₂ x₃ ≠ 0) (s : Finset K)
    (hs : ∀ x₄ ∈ s, S₄ a b x₁ x₂ x₃ x₄ = 0) : s.card ≤ 4 := by
  set q := S₄slice a b x₁ x₂ x₃
  have hq : q.natDegree = 4 := S₄slice_natDegree a b x₁ x₂ x₃ h
  have hq0 : q ≠ 0 := by intro h0; rw [h0, natDegree_zero] at hq; norm_num at hq
  have hsub : s ⊆ q.roots.toFinset := by
    intro x hx
    rw [Multiset.mem_toFinset, mem_roots hq0, IsRoot, S₄slice_eval]
    exact hs x hx
  calc s.card ≤ q.roots.toFinset.card := Finset.card_le_card hsub
    _ ≤ Multiset.card q.roots := Multiset.toFinset_card_le _
    _ ≤ q.natDegree := q.card_roots'
    _ = 4 := hq

end Ecdlp.Semaev
